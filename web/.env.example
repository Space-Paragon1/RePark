# Same Supabase project and API as the mobile app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=https://your-railway-app.up.railway.app

# Optional: app store links shown on the home page. Leave empty to hide.
NEXT_PUBLIC_ANDROID_APP_URL=
NEXT_PUBLIC_IOS_APP_URL=

# Optional: the site's own address, for share-image links. Defaults to https://re-park.vercel.app
NEXT_PUBLIC_SITE_URL=

# Optional: where the Contact form sends email. The form says it isn't set up until this is set.
NEXT_PUBLIC_SUPPORT_EMAIL=
